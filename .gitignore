
# ==========================================
# Occulto - Git Ignore
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
wheels/

# Jupyter Notebook
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# Scientific Data
# ==========================================

# Raw astronomical data
data/raw/
*.fits
*.fits.gz
*.fit
*.fts

# Processed data
data/processed/
data/interim/

# Generated outputs
data/output/
results/
outputs/

# Large scientific files
*.hdf5
*.h5
*.parquet

# ==========================================
# C++ Build Artifacts
# ==========================================

build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.out

# ==========================================
# Logs and Temporary Files
# ==========================================

*.log
*.tmp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# IDE and Editors
# ==========================================

.vscode/
.idea/
*.code-workspace

# Vim / Neovim
*.swp
*.swo
*~

# ==========================================
# Environment Variables and Secrets
# ==========================================

.env
.env.*
!.env.example

# Credentials
credentials.json
secrets.json
*.pem
*.key

# ==========================================
# OS
# ==========================================

.Trash-*

